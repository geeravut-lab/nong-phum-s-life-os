# ค่าตามตาราง env ในขั้น 2.7 ของ docs/PHASE-0-MIGRATION.md
# ห้ามใส่ค่าจริงในไฟล์นี้ — คัดลอกไปเป็น .env หรือ .env.local แล้วใส่ค่าจริงที่นั่น

# --- client (เปิดเผยได้ RLS คุ้มครองอยู่) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- server (fallback ตอน SSR — ตั้งค่าเดียวกับตัว VITE_ ด้านบน) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ห้ามขึ้นต้นด้วย VITE_ เด็ดขาด — ข้ามผ่าน RLS ได้ทั้งหมด
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (server เท่านั้น) ---
# anthropic | openai | google — ไม่ใส่ = anthropic
AI_PROVIDER=
# เว้นว่าง = ปิด fallback
AI_FALLBACK_PROVIDER=

# ใส่เฉพาะเจ้าที่จะใช้ — ห้ามขึ้นต้นด้วย VITE_
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
